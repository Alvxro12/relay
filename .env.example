# Copia este archivo como .env y reemplaza los valores.
#
# application.yaml importa este archivo con
#   spring.config.import: "optional:file:./.env[.properties]"
# asi que alcanza con tenerlo aca: no hace falta exportar nada ni configurar
# variables en la run config de IntelliJ. Se parsea como un .properties.
#
# Una variable de entorno real le gana a lo que diga este archivo, asi que en
# produccion (donde no hay .env) manda el entorno.

# Contraseña del usuario 'sa' de SQL Server.
# Copiá este archivo como .env y reemplazá el valor por tu propia contraseña.
DB_PASSWORD=your_password_here
# Secreto compartido con el proveedor de pagos para firmar los webhooks (HMAC-SHA256).
# En producción va un valor generado al azar y rotable, nunca este.
WEBHOOK_SECRET=your_webhook_secret_here
# Clave HMAC de los JWT de acceso. Base64 de 32 bytes aleatorios (256 bits).
# Generar con:
#   openssl rand -base64 32
# o en PowerShell:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
JWT_SECRET=your_base64_jwt_secret_here
